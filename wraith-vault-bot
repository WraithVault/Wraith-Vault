/*
========================================
HOME / TEST ROUTE
========================================
*/

app.get("/", (req, res) => {

    res.json({
        online: true,
        service: "Wraith Vault Discord API",
        version: "1.0"
    });

});


/*
========================================
STAFF API
========================================
*/

app.get("/staff", async (req, res) => {

    try {

        const guild = client.guilds.cache.first();

        if (!guild) {

            return res.status(503).json({
                error: "Discord server not found"
            });

        }

        const staffData = {};

        for (const [name, data] of Object.entries(STAFF)) {

            try {

                const member =
                    await guild.members.fetch(data.id);

                const presence =
                    member.presence;

                /*
                ================================
                STATUS
                ================================
                */

                let status = "offline";

                if (presence) {
                    status = presence.status;
                }


                /*
                ================================
                DISCORD ACTIVITIES
                ================================
                */

                const activities =
                    presence?.activities?.map(activity => {

                        return {

                            name:
                                activity.name || null,

                            type:
                                activity.type ?? null,

                            details:
                                activity.details || null,

                            state:
                                activity.state || null

                        };

                    }) || [];


                /*
                ================================
                DISCORD ROLES
                ================================
                */

                const roles =
                    member.roles.cache

                        .filter(role => role.id !== guild.id)

                        .map(role => role.name);


                /*
                ================================
                STAFF DATA
                ================================
                */

                staffData[name] = {

                    id:
                        member.user.id,

                    username:
                        member.user.username,

                    displayName:
                        member.displayName,

                    avatar:
                        member.user.displayAvatarURL({
                            size: 256,
                            extension: "png"
                        }),

                    status:
                        status,

                    activities:
                        activities,

                    roles:
                        roles

                };


            } catch (error) {

                console.error(
                    `Could not load ${name}:`,
                    error.message
                );


                staffData[name] = {

                    id:
                        data.id,

                    username:
                        null,

                    displayName:
                        name,

                    avatar:
                        null,

                    status:
                        "offline",

                    activities:
                        [],

                    roles:
                        []

                };

            }

        }


        res.json(staffData);


    } catch (error) {

        console.error(error);

        res.status(500).json({

            error:
                "Internal server error"

        });

    }

});


/*
========================================
DISCORD BOT READY
========================================
*/

client.once("ready", () => {

    console.log(
        "================================"
    );

    console.log(
        `Wraith Vault Bot: ${client.user.tag}`
    );

    console.log(
        `Servers: ${client.guilds.cache.size}`
    );

    console.log(
        "Discord bot is online."
    );

    console.log(
        "================================"
    );

});


/*
========================================
DISCORD LOGIN
========================================

IMPORTANT:
The token is NOT written here.

The hosting service will provide it
through the DISCORD_TOKEN environment
variable.
*/

if (!process.env.DISCORD_TOKEN) {

    console.error(
        "ERROR: DISCORD_TOKEN is missing."
    );

} else {

    client.login(
        process.env.DISCORD_TOKEN
    );

}


/*
========================================
START API SERVER
========================================
*/

app.listen(PORT, () => {

    console.log(
        `Wraith Vault API running on port ${PORT}`
    );

});
